# Bitrix core and runtime live in Docker volumes; if a core is ever unpacked here, never commit it
/bitrix/

# Static preview output and browser reports
/dist/
/playwright-report/
/test-results/

# Private migration bundles include the database and runtime credentials.
/.migration/

# Machine-specific server restart policy; provisioned during migration.
/docker-compose.override.yml
