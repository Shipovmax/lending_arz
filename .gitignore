# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Bitrix cache and generated
/bitrix/cache/
/bitrix/managed_cache/
/bitrix/stack_cache/
/bitrix/backup/
/bitrix/tmp/
/bitrix/html_pages/
